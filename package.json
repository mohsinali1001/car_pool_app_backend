{
  "name": "carpool-backend",
  "version": "1.0.0",
  "description": "Carpool sharing backend API with real-time bookings and ride management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node tests/liveSmoke.js",
    "cleanup": "node scheduledCleanup.js",
    "cleanup:test": "node scheduledCleanup.js --test",
    "cleanup:now": "node -e \"require('./src/utils/throttledCleanup').runAllCleanup()\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js"
  },
  "keywords": [
    "carpool",
    "ride-sharing",
    "firebase",
    "express",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^11.0.0",
    "helmet": "^7.0.0",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0"
  }
}
